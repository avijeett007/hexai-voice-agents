# Production Environment Configuration for NHS Virtual Assistant Agent
# Copy this file to .env and fill in the actual values

# ============================================================================
# LiveKit Configuration (Required)
# ============================================================================
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-server.com

# ============================================================================
# AI Model Configuration
# ============================================================================
# OpenAI API Key (Required - used for embeddings, LLM, and analytics)
OPENAI_API_KEY=

# Cerebras API Key (Optional - cost-efficient alternative for knowledge base selection)
# If not provided, will fall back to OpenAI
CEREBRAS_API_KEY=

# Model name for LLM (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# ============================================================================
# Voice Processing (LiveKit Plugins)
# ============================================================================
# Cartesia API Key (Required - for Text-to-Speech)
CARTESIA_API_KEY=

# Deepgram API Key (Required - for Speech-to-Text)
DEEPGRAM_API_KEY=

# ============================================================================
# Vector Database Configuration (Required)
# ============================================================================
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TLS=true

# ============================================================================
# Backend API Configuration (Required)
# ============================================================================
# NHS Embedding Engine Portal API
NHS_API_BASE=https://api.hexai.care/api
NHS_API_KEY=

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Optional: Override default endpoints
# ============================================================================
# PATIENT_VERIFY_ENDPOINT=${NHS_API_BASE}/patients/verify
# DOCTOR_VERIFY_ENDPOINT=${NHS_API_BASE}/doctors/verify
# MEDICAL_RECORDS_ENDPOINT=${NHS_API_BASE}/medical-records/patient
# MEMORY_MAP_ENDPOINT=${NHS_API_BASE}/memory-map
# ANALYTICS_ENDPOINT=${NHS_API_BASE}/analytics/session

