# Build stage
FROM python:3.10-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libportaudio2 \
    portaudio19-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install requirements
COPY requirements.txt .

# Install PyTorch first separately (better stability)
RUN pip install --no-cache-dir torch==2.0.0

# Install remaining dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Final stage
FROM python:3.10-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libportaudio2 \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy all necessary files
COPY . .

# Create necessary directories with proper permissions
RUN mkdir -p ./data /root/.cache/livekit-plugins-turn-detector && \
    chmod -R 755 /root/.cache

# Download models during build
RUN python oyos_coach_disc_agent.py download-files || echo "WARNING: Model download failed"

# Create empty .env file (will be populated via environment variables or volume mount)
RUN touch .env

# Set environment variable for unbuffered output
ENV PYTHONUNBUFFERED=1

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD ps aux | grep python | grep oyos_coach_disc_agent.py || exit 1

# Modify startup script
RUN echo '#!/bin/bash\n\
echo "Initializing environment..."\n\
mkdir -p /root/.cache/livekit-plugins-turn-detector\n\
chmod -R 755 /root/.cache\n\
echo "Starting OYOS Virtual Assistant..."\n\
exec python oyos_coach_disc_agent.py start' > /app/start.sh && \
    chmod +x /app/start.sh

# Run the startup script
CMD ["/app/start.sh"] 